# Copy this file to .env and fill in your own values. Never commit .env.

ANTHROPIC_API_KEY=

# Paper-trading credentials from https://app.alpaca.markets/paper/dashboard/overview
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
APCA_BASE_URL=https://paper-api.alpaca.markets

# Free-tier key from https://finnhub.io — used for real earnings-date lookups
# instead of inferring earnings timing from news headlines.
FINNHUB_API_KEY=

# Free-tier key from https://resend.com — used to email full report content.
RESEND_API_KEY=
REPORT_TO_EMAIL=

# Set to 1 only for unattended/scheduled runs (e.g. the Trading Session cloud
# routine) — auto-approves orders instead of prompting, but requires limit
# orders and enforces the caps below. Leave unset for interactive/manual use.
TRADER_UNATTENDED=
TRADER_MAX_ORDER_NOTIONAL=2000
TRADER_MAX_ORDERS_PER_RUN=10
TRADER_DAILY_NOTIONAL_CAP=500
TRADER_WEEKLY_NOTIONAL_CAP=1000

# Crypto Scalper (crypto-scalper/) — a second, independent agent on its OWN
# separate Alpaca paper account (create a second paper account at
# https://app.alpaca.markets/paper/dashboard/overview and generate keys for
# it — do not reuse the equities keys above). See crypto-scalper/CLAUDE.md
# for the strategy and why each of these exists.
CRYPTO_APCA_API_KEY_ID=
CRYPTO_APCA_API_SECRET_KEY=
CRYPTO_APCA_BASE_URL=https://paper-api.alpaca.markets

# Same on/off pattern as TRADER_UNATTENDED above.
CRYPTO_SCALPER_UNATTENDED=
CRYPTO_MAX_ORDER_NOTIONAL=200
CRYPTO_MAX_ORDERS_PER_RUN=5
CRYPTO_DAILY_NOTIONAL_CAP=300
CRYPTO_WEEKLY_NOTIONAL_CAP=1500
CRYPTO_MAX_POSITIONS=5
CRYPTO_MAX_PER_CATEGORY=2
CRYPTO_PER_TRADE_PCT_CAP=0.10
CRYPTO_MAX_HOLD_HOURS=4
CRYPTO_PROFIT_TARGET_PCT=1.5
CRYPTO_STOP_LOSS_PCT=0.75
CRYPTO_ATR_SPIKE_MULTIPLE=2.0
CRYPTO_TARGET_RISK_PCT=1.0
CRYPTO_ATR_STOP_MULTIPLIER=1.5
CRYPTO_ATR_TP_MULTIPLIER=3.0
CRYPTO_RSI_LOOKBACK_BARS=12
